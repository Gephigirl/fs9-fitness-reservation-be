@baseUrl = http://localhost:{{$dotenv PORT}}/api

### 1. ADMIN 로그인
# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@test.com",
  "password": "test1234"
}

###
@adminToken = {{adminLogin.response.body.data.accessToken}}

### 2. CUSTOMER 로그인
# @name customerLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "customer@test.com",
  "password": "newpassword123"
}

###
@customerToken = {{customerLogin.response.body.data.accessToken}}

### 3. SELLER 로그인
# @name sellerLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "seller@test.com",
  "password": "test1234"
}

###
@sellerToken = {{sellerLogin.response.body.data.accessToken}}

### ========== 회원 통계 ==========

### 4. 회원 통계 조회
GET {{baseUrl}}/users/stats

### ========== 회원 목록 ==========

### 5. 회원 목록 조회 (기본)
GET {{baseUrl}}/users

### 6. 회원 목록 조회 (페이지네이션)
GET {{baseUrl}}/users?page=1&limit=5

### 7. 회원 목록 조회 (역할 필터 - CUSTOMER)
GET {{baseUrl}}/users?role=CUSTOMER

### 8. 회원 목록 조회 (역할 필터 - SELLER)
GET {{baseUrl}}/users?role=SELLER

### 9. 회원 목록 조회 (닉네임 검색)
GET {{baseUrl}}/users?searchType=nickname&search=테스트

### 10. 회원 목록 조회 (이메일 검색)
GET {{baseUrl}}/users?searchType=email&search=test

### 11. 회원 목록 조회 (전화번호 검색)
GET {{baseUrl}}/users?searchType=phone&search=010

### ========== 회원 상세 ==========

### 12. 회원 상세 조회 (고정 ID)
GET {{baseUrl}}/users/test-customer-id-01

### ========== 프로필 수정 ==========

### 13. 프로필 수정 - 닉네임 변경 
PATCH {{baseUrl}}/users/me
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "nickname": "수정된닉네임"
}

### 14. 프로필 수정 - 연락처 변경 
PATCH {{baseUrl}}/users/me
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "phone": "01011112222"
}

### 15. 프로필 수정 - 비밀번호 변경 
PATCH {{baseUrl}}/users/me
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "password": "test1234"
}

### 16. 프로필 수정 - 자기소개 변경
PATCH {{baseUrl}}/users/me
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{
  "introduction": "안녕하세요, 10년 경력의 피트니스 트레이너입니다."
}

### 17. 프로필 수정 - 복합 변경 
PATCH {{baseUrl}}/users/me
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{
  "nickname": "김트레이너",
  "phone": "01033332444",
  "introduction": "전문 트레이너입니다."
}

### 18. 로그아웃 
POST {{baseUrl}}/auth/logout

### 19. 프로필 수정 - 빈 요청 (400 에러)
PATCH {{baseUrl}}/users/me
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{}

### 20. 프로필 수정 - 로그아웃 후 (401 에러)
PATCH {{baseUrl}}/users/me
Content-Type: application/json

{
  "nickname": "에러테스트"
}

